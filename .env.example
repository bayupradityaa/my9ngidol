# Firebase Web config (client-side). These are PUBLIC by design — security comes
# from Firestore Security Rules, not from hiding these values.
# Copy this file to `.env.local` and fill with your Firebase project values.
# All Vite client env vars MUST be prefixed with VITE_.
#
# If you leave these empty, the app still runs and falls back to localStorage
# for rankings (no cloud sync). Fill them in to enable shared rankings.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Opsional — isi untuk mengaktifkan Google Analytics
VITE_FIREBASE_MEASUREMENT_ID=

# Base URL for member photos. Default "/members" serves from public/members.
# Later you can point this to a Cloudflare R2 public URL without code changes,
# e.g. https://pub-xxxx.r2.dev/members
VITE_MEMBER_PHOTO_BASE=/members
